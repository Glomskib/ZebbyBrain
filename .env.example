# Server
PORT=5000
NODE_ENV=development
APP_URL=https://your-repl.your-username.replit.dev

# OpenAI Configuration
# Use the dedicated Zebby's World org/project that has the Healthcare Addendum
# signed. Every AI call goes through server/lib/aiClient.ts (server-side only).
OPENAI_API_KEY=sk-***
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
OPENAI_MODEL=gpt-5
OPENAI_FAST_MODEL=gpt-4o-mini

# Database (Neon)
DATABASE_URL=postgresql://user:pass@host:port/database

# Replit Auth (OIDC)
REPLIT_OIDC_CLIENT_ID=***
REPLIT_OIDC_CLIENT_SECRET=***
REPLIT_OIDC_ISSUER=***

# Session Management
SESSION_SECRET=***

# JWT for Testing Auth (development/staging only)
JWT_SECRET=change_me_32chars_minimum_length

# Test Login (development/staging only). The server refuses to start in
# production if this is true.
ALLOW_TEST_LOGIN=false
TEST_LOGIN_PASSWORD=

# Stripe Configuration
STRIPE_SECRET_KEY=sk_***
STRIPE_WEBHOOK_SECRET=whsec_***
STRIPE_PLUS_PRICE_ID=price_***
# Optional: Stripe Coupon for promotions (e.g., Kickstarter 100% off X months)
STRIPE_KS_COUPON_ID=coupon_***
# Optional: Default trial days for all subscriptions
STRIPE_TRIAL_DAYS=0
# Optional: Allowed coupon IDs for abuse prevention (comma-separated)
ALLOWED_COUPON_IDS=coupon_KS100OFF3,coupon_BETA50

# OpenWeather API
OPENWEATHER_API_KEY=***

# PostgreSQL Direct Connection (optional)
PGDATABASE=***
PGHOST=***
PGPASSWORD=***
PGPORT=5432
PGUSER=***

# Feature Toggles (Legacy)
FEATURE_MARKETPLACE=true
FEATURE_AI_INSIGHTS=true
FEATURE_WEATHER_INTEGRATION=true

# Wave-Based Feature Flags (New)
FF_WEATHER=true
FF_AI_TRENDS=true
FF_BODY_PARTS=true
FF_AVATAR=true
FF_SHOPIFY=false
FF_GROUPS=false
FF_HERD=false
FF_REFERRALS=false
FF_REWARDS=false

# Shopify Integration (for FF_SHOPIFY)
SHOPIFY_STORE_DOMAIN=yourstore.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=***

# Analytics (optional)
ANALYTICS_SALT=change_me_in_production

# Account deletion (on by default; required by the App Store)
FF_DELETE_ACCOUNT=true
VITE_FF_DELETE_ACCOUNT=true

# Visit Recorder (Zebby+). Off until the go-live gate is passed.
FF_VISIT_RECORDER=false
# 32 random bytes as 64 hex chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Different from every other key. Losing it makes saved transcripts unreadable.
HEALTH_DATA_KEY=
# Only during a key rotation: the previous key, so old data still opens.
HEALTH_DATA_KEY_PREVIOUS=
# Supabase project used ONLY for private visit audio storage (server-side key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
VISIT_AUDIO_BUCKET=visit-audio
