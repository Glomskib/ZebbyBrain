# Server
PORT=5000
NODE_ENV=development
APP_URL=https://your-repl.your-username.replit.dev

# OpenAI Configuration
OPENAI_API_KEY=sk-***
OPENAI_MODEL=gpt-5

# Database (Neon)
DATABASE_URL=postgresql://user:pass@host:port/database

# Replit Auth (OIDC)
REPLIT_OIDC_CLIENT_ID=***
REPLIT_OIDC_CLIENT_SECRET=***
REPLIT_OIDC_ISSUER=***

# Session Management
SESSION_SECRET=***

# JWT for Testing Auth (development/staging only)
JWT_SECRET=change_me_32chars_minimum_length

# Test Login (development/staging only)
ALLOW_TEST_LOGIN=true
TEST_LOGIN_PASSWORD=letmein

# Stripe Configuration
STRIPE_SECRET_KEY=sk_***
STRIPE_WEBHOOK_SECRET=whsec_***
STRIPE_PLUS_PRICE_ID=price_***
# Optional: Stripe Coupon for promotions (e.g., Kickstarter 100% off X months)
STRIPE_KS_COUPON_ID=coupon_***
# Optional: Default trial days for all subscriptions
STRIPE_TRIAL_DAYS=0

# OpenWeather API
OPENWEATHER_API_KEY=***

# PostgreSQL Direct Connection (optional)
PGDATABASE=***
PGHOST=***
PGPASSWORD=***
PGPORT=5432
PGUSER=***

# Feature Toggles
FEATURE_MARKETPLACE=true
FEATURE_AI_INSIGHTS=true
FEATURE_WEATHER_INTEGRATION=true

# Analytics (optional)
ANALYTICS_SALT=change_me_in_production